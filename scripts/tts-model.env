# The prebuilt int8 MMS folder that scripts/setup-tts.sh downloads instead of exporting (no torch needed).
# Rebuild it after changing RECIPE in active/tts-finetune/export_onnx.py: zip model.int8.onnx, vocab.json,
# active-mms.json and NOTICE.txt from .tools/tts-models/mms-eng-int8, upload it, then update all three values.
# An empty URL (MMS_INT8_URL= in the environment) makes setup export the model itself.
MMS_INT8_URL="${MMS_INT8_URL-https://huggingface.co/danyalmalik/active-mms-tts-eng-int8/resolve/main/mms-eng-int8-r3.zip}"
MMS_INT8_RECIPE=3
MMS_INT8_SHA256="42ea1a7ead253df6b19b39274e43cb12cbe9fadc91ed56f199bcd15a15539438"
